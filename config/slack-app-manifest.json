{
  "display_information": {
    "name": "AI Auto"
  },
  "features": {
    "bot_user": {
      "display_name": "AI Auto",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/ai-auto",
        "description": "AI Auto command router",
        "usage_hint": "whatnow | status | now | instruct <지시> | show | clear | help",
        "should_escape": false
      },
      {
        "command": "/aiauto",
        "description": "AI Auto command router",
        "usage_hint": "whatnow | status | now | instruct <지시> | show | clear | help",
        "should_escape": false
      },
      {
        "command": "/whatnow",
        "description": "AI Auto 실행 누적 요약을 확인합니다.",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/now",
        "description": "AI Auto 현재 상태와 최근 작업을 요약합니다.",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/instruct",
        "description": "AI Auto 실행 중인 세션에 자연어 지시를 추가합니다.",
        "usage_hint": "자연어 지시",
        "should_escape": false
      },
      {
        "command": "/show",
        "description": "AI Auto 활성 지시를 확인합니다.",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/clear",
        "description": "AI Auto 활성 지시를 정리합니다.",
        "usage_hint": "",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "is_hosted": false,
    "token_rotation_enabled": false
  }
}

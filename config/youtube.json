{
  "workspace": "../youtube",
  "model": "gpt-5.5",
  "reasoningEffort": "high",
  "cycleInterval": "30s",
  "maxRuntime": "24h",
  "maxIterationsPerCycle": 5,
  "discussionRounds": 5,
  "logDir": ".ai-auto",
  "instructionFile": ".ai-auto/instructions.md",
  "autoCommit": true,
  "push": {
    "enabled": true,
    "command": "git push"
  },
  "failureLoop": {
    "enabled": true,
    "maxRepeatedFailures": 3,
    "lookbackCycles": 6,
    "action": "stop"
  },
  "restart": {
    "cleanCycleLogs": true,
    "archiveCycleLogs": true,
    "stateFile": ".ai-auto/run-state.json"
  },
  "allowPlannerCommandOverride": true,
  "commandDiscovery": {
    "enabled": true,
    "requireTests": true,
    "fallbackVerifyCommands": [
      "git diff --check"
    ]
  },
  "codexConsultation": {
    "enabled": true,
    "questionSource": "openai",
    "sandbox": "read-only",
    "approvalPolicy": "never",
    "timeoutMs": 1200000
  },
  "commands": {
    "test": [],
    "verify": [],
    "status": [
      "git status --short"
    ]
  },
  "codex": {
    "command": "codex",
    "model": "gpt-5.5",
    "sandbox": "workspace-write",
    "approvalPolicy": "never"
  },
  "deploy": {
    "enabled": false,
    "command": "",
    "requireCleanGit": true,
    "requireCommand": false,
    "required": false
  },
  "telegram": {
    "enabled": false,
    "botTokenEnv": "TELEGRAM_BOT_TOKEN",
    "chatIdEnv": "TELEGRAM_CHAT_ID",
    "chatId": "",
    "reportCycles": true,
    "commands": {
      "enabled": true,
      "allowedChatIds": [],
      "pollTimeoutSeconds": 25,
      "stateFile": ".ai-auto/telegram-offset.json"
    }
  },
  "slack": {
    "enabled": true,
    "botTokenEnv": "SLACK_BOT_TOKEN",
    "appTokenEnv": "SLACK_APP_TOKEN",
    "channelId": "C0B5YH9HYF8",
    "reportCycles": true,
    "commands": {
      "enabled": true,
      "allowedUserIds": [],
      "reconnectDelaySeconds": 5
    }
  },
  "goals": [
    "최우선: videos/에 원본 합주 영상을 넣으면 합주별 시작/끝을 감지해 clip으로 자르는 파이프라인을 만든다.",
    "최우선: 잘린 합주 clip을 .env의 PLAYLIST_ID 재생목록에 순서대로 업로드하고 결과를 기록한다.",
    "기존 videos/ 폴더 일괄 업로드 동작은 새 파이프라인과 호환되게 유지한다.",
    "합주 구간 감지 품질을 샘플과 리포트로 검증하며 개선한다.",
    "YouTube API 업로드는 재시도, 중복 업로드 방지, playlist 추가 검증을 갖춘다.",
    "CLI 사용 흐름을 원본 감지, 분할, 업로드, 리포트 확인 순서로 단순하게 만든다."
  ],
  "rules": [
    "secrets, .env, 임시 output은 커밋하지 않는다.",
    "모든 변경사항은 commit하고 push한다. commit만 되고 push되지 않은 상태를 완료로 보지 않는다.",
    "client_secret.json, OAuth token, PLAYLIST_ID 같은 인증/계정 값은 코드나 config에 하드코딩하지 않는다.",
    "YouTube 업로드 테스트는 기본적으로 mock/dry-run으로 검증하고, 실제 업로드는 명시된 실행 경로에서만 수행한다.",
    "원본 영상, 잘린 clip, 프레임/오디오 추출물은 커밋하지 않는다.",
    "임시 작업은 프로젝트 내부 tmp/에서만 수행하고, 작업 후 비운다.",
    "유지해야 하는 작은 샘플, 감지 기준, 업로드 manifest/report만 repo에 저장한다.",
    "같은 원본/clip을 중복 업로드하지 않도록 업로드 전 manifest나 YouTube 결과를 확인한다.",
    "합주 구간 감지는 검증 가능한 timestamp 근거와 before/after 리포트를 남긴다.",
    "Docker는 로컬에서 띄우지 않는다.",
    "cycle 결과에는 감지된 구간, 생성 clip 경로, 업로드 video id, playlist 추가 결과를 짧게 보고한다."
  ],
  "mission": ""
}
